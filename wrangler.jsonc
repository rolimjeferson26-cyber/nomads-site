{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomads-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nomads-site"
    }
  ],
  "workers_dev": true,
  // DOMÍNIO FINAL: descomentar SÓ quando a v2 estiver pronta (ver README, "Passar para o domínio").
  // "routes": [{ "pattern": "nomadstextil.store", "custom_domain": true }],
  "observability": { "enabled": true }
  // Segredos (NUNCA aqui): npx wrangler secret put NOME
  // SUPABASE_SECRET_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // RESEND_API_KEY, OWNER_EMAIL, EMAIL_FROM, RATE_LIMIT_SALT
}
