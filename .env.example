# Copiar para .env.local (desenvolvimento) ou .dev.vars (wrangler preview).
# NUNCA fazer commit de valores reais. Em produção, os segredos vão para
#   npx wrangler secret put NOME

# ---- Públicos (definidos em .env.production para a build) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Segredos (só servidor) ----
SUPABASE_SECRET_KEY=sb_secret_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RESEND_API_KEY=re_xxx
OWNER_EMAIL=dono@exemplo.pt
EMAIL_FROM=NOMAD'S <encomendas@nomadstextil.store>
RATE_LIMIT_SALT=uma-frase-longa-e-aleatoria

# ---- Opcional: CTT Expresso (quando houver contrato) ----
CTT_EXPRESSO_API_URL=
CTT_EXPRESSO_CLIENT_ID=
CTT_EXPRESSO_API_KEY=
